NODE_ENV=production
PUBLIC_ORIGIN=https://inmobiliaria.confianzagsa.com
# PORT is injected by the hosting platform. Do not hardcode it.
DB_DRIVER=mysql
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_DATABASE=your-database
MYSQL_USER=your-user
MYSQL_PASSWORD=configure-in-hostinger
# MYSQL_SSL=true only if supported by your database server.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=configure-a-unique-password-at-least-12-characters
# Generate each key separately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=configure-64-hex-characters
BACKUP_ENCRYPTION_KEY=configure-another-64-hex-characters
SEED_DEMO=true
# UPLOAD_DIR must point to storage that survives redeployment.
# Alternative development mode, Node.js 24:
# DB_DRIVER=sqlite
# DB_PATH=/persistent-data/confianza.sqlite
# UPLOAD_DIR=/persistent-data/uploads

# Email notifications: configure real values only in the server environment.
# Leave sending disabled until the provider, costs and test recipient are confirmed.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# Hostinger Email uses implicit TLS on port 465.
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
